				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
EXIF="$HOME/GIT/exif/exif"

setopt extended_glob null_glob
typeset -a files
for f in "$@"; do
  if [[ -d "$f" ]]; then
    files+=("$f"/**/*.(#i)(jpg|jpeg)(N.))
  elif [[ -f "$f" ]]; then
    files+=("$f")
  fi
done

if (( ${#files[@]} == 0 )); then
  osascript -e 'display dialog "No JPEG files in the selection." buttons {"OK"} default button "OK" with title "exif" with icon caution' &gt;/dev/null 2&gt;&amp;1
  exit 0
fi

osascript - "${#files[@]}" &gt;/dev/null 2&gt;&amp;1 &lt;&lt;'OSA' || exit 0
on run argv
  display dialog "Write EXIF metadata onto " &amp; (item 1 of argv) &amp; " file(s)?" &amp; return &amp; "Originals are overwritten in place." buttons {"Cancel", "Process"} default button "Process" cancel button "Cancel" with title "exif" with icon caution
end run
OSA

out="$("$EXIF" "${files[@]}" 2&gt;&amp;1)"

problems="$(print -r -- "$out" | grep -E '^(SKIP|FAIL)' | head -15)"
result="$(print -r -- "$out" | grep -E 'updated' | tail -1)"
msg="$result"
[[ -n "$problems" ]] &amp;&amp; msg="$result"$'\n\n'"$problems"

osascript - "$msg" &gt;/dev/null 2&gt;&amp;1 &lt;&lt;'OSA'
on run argv
  display dialog (item 1 of argv) buttons {"OK"} default button "OK" with title "exif"
end run
OSA
</string>
